# Copia questo file come .env e inserisci le tue chiavi API reali

# === API KEYS ===
# Solo informazioni sensibili vanno qui - il resto è in config.py

# Google API Key per Gemini
GOOGLE_API_KEY=your_google_api_key_here

# Anthropic Claude API Key
CLAUDE_API_KEY=your_claude_api_key_here

# OpenAI API Key (se utilizzata)
OPENAI_API_KEY=your_openai_api_key_here

# Hugging Face API Key (opzionale)
# HUGGINGFACE_API_KEY=your_hf_key_here