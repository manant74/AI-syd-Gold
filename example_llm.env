# === ESEMPIO CONFIGURAZIONE PER OPENAI ===
# Copia questo contenuto nel file .env per usare OpenAI

# === CONFIGURAZIONE LLM PROVIDER ===
LLM_PROVIDER=openai
EMBEDDING_PROVIDER=openai

# === API KEYS ===
OPENAI_API_KEY=your_openai_api_key_here

PDF_DIRECTORY_PATH="pdfs/"
VECTOR_STORE_PATH="vector_store_cache"

# === MODELLI OPENAI DISPONIBILI ==# === ESEMPIO CONFIGURAZIONE PER ANTHROPIC CLAUDE ===
# Copia questo contenuto nel file .env per usare Claude

# === CONFIGURAZIONE LLM PROVIDER ===
LLM_PROVIDER=anthropic
EMBEDDING_PROVIDER=google

# === CONFIGURAZIONE LLM PROVIDER ===
LLM_PROVIDER=openai
EMBEDDING_PROVIDER=openai

# === API KEYS ===
GOOGLE_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_openai_api_key_here
OPENAI_API_KEY=your_openai_api_key_here


PDF_DIRECTORY_PATH="pdfs/"
VECTOR_STORE_PATH="vector_store_cache"

# === MODELLI ANTHROPIC DISPONIBILI ===
# claude-3-5-sonnet-20241022  (Claude Sonnet 3.5)
# claude-3-5-haiku-20241022   (Claude Haiku 3.5)
# claude-4-sonnet-20250101    (Claude Sonnet 4)
# claude-4-opus-20250101      (Claude Opus 4.x)

# === MODELLI OPENAI DISPONIBILI ===
# gpt-4o                (GPT-4 Omni)
# gpt-4o-mini           (GPT-4 Omni Mini)
# gpt-4-turbo           (GPT-4 Turbo)
# gpt-3.5-turbo         (GPT-3.5 Turbo)


LLM_MODEL_NAME="claude-3-5-sonnet-20241022"


# === EMBEDDINGS OPENAI DISPONIBILI ===
# text-embedding-3-large
# text-embedding-3-small
# text-embedding-ada-002

EMBEDDING_MODEL="text-embedding-3-small"


#RETRIEVER_K=7
#SEARCH_TYPE="similarity"

SEARCH_TYPE="mmr"
RETRIEVER_K=5
RETRIEVER_FETCH_K=20
RETRIEVER_LAMBDA_MULT=0.6

USE_HYDE=true=
# gpt-4o                (GPT-4 Omni)
# gpt-4o-mini           (GPT-4 Omni Mini)
# gpt-4-turbo           (GPT-4 Turbo)
# gpt-3.5-turbo         (GPT-3.5 Turbo)

LLM_MODEL_NAME="gpt-4o"

# === EMBEDDINGS OPENAI DISPONIBILI ===
# text-embedding-3-large
# text-embedding-3-small
# text-embedding-ada-002

EMBEDDING_MODEL="text-embedding-3-small"

#RETRIEVER_K=7
#SEARCH_TYPE="similarity"

SEARCH_TYPE="mmr"
RETRIEVER_K=5
RETRIEVER_FETCH_K=20
RETRIEVER_LAMBDA_MULT=0.6

USE_HYDE=true